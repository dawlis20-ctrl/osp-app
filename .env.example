# Skopiuj ten plik jako ".env" i uzupełnij. Pliku .env NIGDY nie wrzucaj do GitHuba.

# Baza danych (SQLite). Na serwerze podaj pełną ścieżkę, np. file:/home/osp/data/osp.db
DATABASE_URL="file:./dev.db"

# Losowy, długi ciąg znaków (wygeneruj: openssl rand -base64 32). Inny na serwerze niż lokalnie.
AUTH_SECRET=""
# Na serwerze za nginx:
# AUTH_URL="https://app.r-osp.pl"
# AUTH_TRUST_HOST="true"

# Poczta wychodząca (OVH) — tędy wysyłane są raporty (.docx + zdjęcia). Hasło wpisz TYLKO tutaj.
# MX Plan: ssl0.ovh.net, Email Pro: pro1.mail.ovh.net — sprawdź w panelu OVH przy skrzynce.
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER="adres@r-osp.pl"
SMTP_PASS=""
MAIL_FROM="OSP <adres@r-osp.pl>"
# Na jaki adres wysyłać raporty i meldunki
OSP_EMAIL_TO="adres@r-osp.pl"

# Tylko przy pierwszym uruchomieniu na serwerze (npm run db:seed) — potem usuń hasło z pliku:
# SEED_ADMIN_EMAIL="twoj@adres.pl"
# SEED_ADMIN_NAME="Imię Nazwisko"
# SEED_ADMIN_PASSWORD="min. 10 znaków"
