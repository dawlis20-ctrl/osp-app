// Prisma schema — aplikacja OSP (raport z akcji + terminy ważności)
// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  DRUH
  NACZELNIK
  ADMIN
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(DRUH)
  createdAt    DateTime @default(now())
}

model Vehicle {
  id     String  @id @default(cuid())
  name   String
  label  String
  plate  String
  active Boolean @default(true)

  deadlines Deadline[]
}

// Raporty i meldunki nie są zapisywane — tylko wysyłane e-mailem.
// Zapamiętujemy wyłącznie ostatni użyty numer raportu w roku, żeby podpowiadać kolejny.
model ReportCounter {
  year Int @id
  last Int
}

enum DeadlineCategory {
  SPRZET_MEDYCZNY
  SPRZET_RATOWNICZY
  SPRZET_ODO
  SAMOCHOD
}

model Deadline {
  id                String           @id @default(cuid())
  category          DeadlineCategory
  vehicleId         String
  vehicle           Vehicle          @relation(fields: [vehicleId], references: [id])
  label             String
  serialNumber      String?
  subgroup          String?
  kind              String
  dueDate           DateTime
  reminderEmail     String
  lastRemindedStage Int              @default(0)
  createdAt         DateTime         @default(now())
}
