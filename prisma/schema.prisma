// Prisma schema — aplikacja OSP (raport z akcji + terminy ważności)
// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  DRUH
  NACZELNIK
  ADMIN
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(DRUH)
  createdAt    DateTime @default(now())

  crewEntries     ReportCrewEntry[]
  reportsPrepared Report[]          @relation("ReportsPrepared")
  reportsChecked  Report[]          @relation("ReportsChecked")
  meldunki        Meldunek[]
}

model Vehicle {
  id     String  @id @default(cuid())
  name   String
  label  String
  plate  String
  active Boolean @default(true)

  crewEntries ReportCrewEntry[]
  deadlines   Deadline[]
}

enum ReportType {
  AKCJA_RATOWNICZO_GASNICZA
  WYJAZD_GOSPODARCZY
  ZABEZPIECZENIE
  CWICZENIA
}

enum ReportPurpose {
  MZ
  P
  AF
}

model Report {
  id                 String        @id @default(cuid())
  number             String        @unique
  type               ReportType
  date               DateTime
  alarmTime          String
  arrivalTime        String
  departureTime      String
  returnTime         String
  alarmedBy          String
  address            String
  purpose            ReportPurpose
  purposeDescription String?
  kpp                String?
  handover           String?
  notes              String?

  preparedById String?
  preparedBy   User?   @relation("ReportsPrepared", fields: [preparedById], references: [id])
  checkedById  String?
  checkedBy    User?   @relation("ReportsChecked", fields: [checkedById], references: [id])

  createdAt DateTime @default(now())

  crew       ReportCrewEntry[]
  equipment  EquipmentUsage[]
  otherUnits OtherUnit[]
}

enum CrewRole {
  DOWODCA
  KIEROWCA
  RATOWNIK
}

model ReportCrewEntry {
  id        String   @id @default(cuid())
  reportId  String
  report    Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  vehicleId String
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id])
  role      CrewRole
  position  Int
  memberId  String?
  member    User?    @relation(fields: [memberId], references: [id])
  freeText  String?
}

model EquipmentUsage {
  id       String @id @default(cuid())
  reportId String
  report   Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  name     String
  workTime String
  notes    String?
}

model OtherUnit {
  id       String @id @default(cuid())
  reportId String
  report   Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  name     String
}

enum DeadlineCategory {
  SPRZET_MEDYCZNY
  SPRZET_RATOWNICZY
  SPRZET_ODO
  SAMOCHOD
}

model Meldunek {
  id                   String    @id @default(cuid())
  jednostkaZglaszajaca String    @default("OSP Skawina II")
  data                 DateTime
  adresZdarzenia       String
  km                   String?
  obiekt               String?
  rodzajZdarzenia      String
  wlasciciel           String?
  sposobZadysponowania String?

  czasZadysponowanie       String
  czasWyjazd                String
  czasNaMiejscu             String
  czasLokalizacjaZagrozenia String?
  czasZakonczenieDzialan    String
  czasWKoszarach            String

  przyczyna      String?
  rodzajDzialan  String?
  sprzetUzyty    String?
  miejsceDzialan String?

  pradowWody             Float?
  zuzytoWody             Float?
  zuzytoSorbentow        Float?
  pradowProszku          Float?
  zuzytoProszku          Float?
  zuzytoNeutralizatorow  Float?
  pradowPiany            Float?
  zuzytoSrPianotworczego Float?

  ofiaraImieNazwisko String?
  ofiaraWiek         String?
  ofiaraPlec         String?
  ofiaraDzialania    String?
  ofiaraSprzet       String?

  straty       Float?
  uratowano    Float?
  powierzchnia Float?
  kubatura     Float?
  dlugosc      Float?
  szerokosc    Float?
  wysokosc     Float?

  warunkiAtmosferyczne String?
  kierujacyNazwisko    String?
  kierujacyImie        String?
  kierujacyOd          String?
  kierujacyDo          String?
  kierujacyJednostka   String?

  opisPrzebiegu      String?
  przekazanieMiejsca String?
  uleglaZniszczeniu  String?

  dataPrzeslania DateTime?
  zglaszajacy    String?

  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  jednostki   MeldunekUnit[]
  inneSluzby  MeldunekOtherService[]
}

model MeldunekUnit {
  id         String   @id @default(cuid())
  meldunekId String
  meldunek   Meldunek @relation(fields: [meldunekId], references: [id], onDelete: Cascade)
  position   Int
  jednostka  String
  samochod   String?
  liczbaOsob String?
}

model MeldunekOtherService {
  id             String   @id @default(cuid())
  meldunekId     String
  meldunek       Meldunek @relation(fields: [meldunekId], references: [id], onDelete: Cascade)
  position       Int
  nazwa          String
  liczbaPojazdow String?
  liczbaOsob     String?
}

model Deadline {
  id                String           @id @default(cuid())
  category          DeadlineCategory
  vehicleId         String
  vehicle           Vehicle          @relation(fields: [vehicleId], references: [id])
  label             String
  kind              String
  dueDate           DateTime
  reminderEmail     String
  lastRemindedStage Int              @default(0)
  createdAt         DateTime         @default(now())
}
